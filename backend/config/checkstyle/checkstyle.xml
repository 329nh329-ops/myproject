<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    このプロジェクト向けの軽量なCheckstyle設定。
    Sun/Googleスタイルをベースに、学習用の小規模プロジェクトに合わせて
    フォーマット系のルールは最小限にし、バグにつながりやすい項目を中心にチェックする。
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <module name="TreeWalker">
        <!-- 未使用import -->
        <module name="UnusedImports"/>
        <!-- import順序の乱れ・重複を検出 -->
        <module name="RedundantImport"/>

        <!-- 等値比較のうっかりミス防止 -->
        <module name="EqualsHashCode"/>
        <module name="StringLiteralEquality"/>

        <!-- 空のcatchブロックでの握りつぶし防止 -->
        <module name="EmptyCatchBlock">
            <property name="commentFormat" value="ignore|expected"/>
        </module>

        <!-- if/for/while等でのブロック省略による事故防止 -->
        <module name="NeedBraces"/>

        <!-- staticフィールドへの誤ったインスタンス経由アクセス防止 -->
        <module name="StaticVariableName"/>

        <!--
            マジックナンバーは情報レベルに留める（学習用途で厳密すぎる制約は避ける）。
            @Column(length=50)や@Size(max=50)のようなアノテーション内の定数は
            バリデーション・DBスキーマの制約値として自明なため対象外とする。
        -->
        <module name="MagicNumber">
            <property name="severity" value="info"/>
            <property name="ignoreNumbers" value="-1, 0, 1, 2"/>
            <property name="ignoreAnnotation" value="true"/>
        </module>
    </module>
</module>
